@model Movies

<h1>Add to Joel's Movie Collection</h1>
<br/>

<form method="post">
    <fieldset>
        <input type="hidden" asp-for="MovieId" />

        <label asp-for="Category">Category:</label>
        <select asp-for="CategoryId">
            <option value="">Select a Category</option>
            @foreach (Category m in ViewBag.Categories)
            {
                <option value="@m.CategoryId">@m.CategoryName</option>
            }
        </select>
        <br/><br/>

        <label asp-for="Title">Title:</label>
        <input asp-for="Title" required>
        <br/><br/>

        <label asp-for="Year">Year:</label>
        <input asp-for="Year" required>
        <br/><br/>

        <label asp-for="Director">Director:</label>
        <input asp-for="Director" required/>
        <br/><br/>

        <label asp-for="Rating">Rating:</label>
        <select asp-for="Rating" required>
            <option value="g">G</option>
            <option value="pg">PG</option>
            <option value="pg13">PG-13</option>
            <option value="r">R</option>
        </select>
        <br/><br/>

        <label>Edited:</label>
        <div>
            <label for="edited-true">Yes</label>
            <input asp-for="Edited" type="radio" id="edited-true" value="true">
            <label for="edited-false">No</label>
            <input asp-for="Edited" type="radio" id="edited-false" value="false">
        </div>
        <br/>

        <label asp-for="LentTo">Lent to:</label>
        <input asp-for="LentTo">
        <br/><br/>

        <label asp-for="CopiedToPlex">Copied to Plex:</label>
        <div>
            <label for="copied-true">Yes</label>
            <input asp-for="CopiedToPlex" type="radio" id="copied-true" value="true">
            <label for="copied-false">No</label>
            <input asp-for="CopiedToPlex" type="radio" id="copied-false" value="false">
        </div>
        <br/>

        <label asp-for="Notes">Notes:</label>
        <textarea asp-for="Notes" size="25" placeholder="Enter notes here..."></textarea>
        <br/><br/>
    </fieldset>

    <button type="submit"> Submit Movie </button>
</form>
